# REFERENCE ONLY — this file is NOT the real nginx config (the real config is not
# in this repository). Use it to DIFF against your actual
# /etc/nginx/sites-available/sevillasinluz.conf (or equivalent), not to overwrite it
# blindly. Placeholders like <CERT_PATH> must be replaced with your real Let's
# Encrypt paths (typically /etc/letsencrypt/live/<domain>/...).
#
# Layout assumed:
#   - infra/nginx/rate-limit.conf         -> /etc/nginx/conf.d/rate-limit.conf (http context)
#   - infra/nginx/security-headers.conf   -> /etc/nginx/snippets/security-headers.conf
#   - infra/nginx/security-headers-api.conf -> /etc/nginx/snippets/security-headers-api.conf
#
# Verify after installing:  sudo nginx -t && sudo systemctl reload nginx
# Rollback:                 restore your previous file from a backup you took first,
#                            e.g. `sudo cp /etc/nginx/sites-available/sevillasinluz.conf{,.bak}`
#                            BEFORE applying any change below.

# ---------------------------------------------------------------------------
# HTTP -> HTTPS redirect for all three hostnames
# ---------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name sevillasinluz.es www.sevillasinluz.es api.sevillasinluz.es;

    # Let's Encrypt HTTP-01 challenge path (certbot webroot plugin)
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# Site: sevillasinluz.es / www.sevillasinluz.es — static Angular SPA
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name sevillasinluz.es www.sevillasinluz.es;

    ssl_certificate     <CERT_PATH>/fullchain.pem;
    ssl_certificate_key <CERT_PATH>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    root /var/www/sevillasinluz;
    index index.html;

    # NOTE: nginx drops server-level add_header directives in any location that defines
    # its own add_header. Every location below sets Cache-Control, so each one must
    # include the security headers again.
    include snippets/security-headers.conf;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 512;

    # Hashed, immutable build assets: cache for a year.
    location ~* \.(?:js|css)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include snippets/security-headers.conf;
        try_files $uri =404;
    }

    location ~* \.(?:png|jpg|jpeg|svg|ico|webp|woff2?)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include snippets/security-headers.conf;
        try_files $uri =404;
    }

    # index.html must always be revalidated so SPA deploys are picked up immediately.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Angular client-side routing fallback.
    location / {
        add_header Cache-Control "no-cache" always;
        include snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}

# ---------------------------------------------------------------------------
# API: api.sevillasinluz.es — reverse proxy to Spring Boot on 127.0.0.1:8081
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.sevillasinluz.es;

    ssl_certificate     <CERT_PATH>/fullchain.pem;
    ssl_certificate_key <CERT_PATH>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    include snippets/security-headers-api.conf;

    client_max_body_size 1m;

    limit_conn conn_per_ip 20;

    # General API traffic.
    location /api/ {
        limit_req zone=api_general burst=20 nodelay;

        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # Admin/expensive endpoints: much stricter rate limit on top of the app's own
    # ADMIN_API_KEY check and fetch cooldown.
    location ~ ^/api/outages/(fetch|export) {
        limit_req zone=api_admin burst=2 nodelay;

        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }
}
